{
  "name": "blanksheet",
  "version": "2.0.0",
  "description": "A CSS reset that gives humans and agents a blank sheet to start a project on: blanked defaults, normalized rules and documented survivors.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "main": "blanksheet.min.css",
  "style": "blanksheet.min.css",
  "scripts": {
    "prepare": "husky",
    "lint:check": "stylelint blanksheet.css",
    "lint:fix": "stylelint --fix blanksheet.css",
    "format:check": "prettier --check README.md AGENTS.md CLAUDE.md CHANGELOG.md package.json pnpm-workspace.yaml kitchen-sink.html tests bench",
    "build": "lightningcss --minify blanksheet.css -o blanksheet.min.css",
    "test": "npm run build && node --test tests/*.test.mjs",
    "bench": "node bench/resets.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "css",
    "reset",
    "css-reset",
    "normalize",
    "ai",
    "agents",
    "blanksheet"
  ],
  "homepage": "https://github.com/P233/blanksheet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P233/blanksheet.git"
  },
  "bugs": {
    "url": "https://github.com/P233/blanksheet/issues"
  },
  "files": [
    "blanksheet.css",
    "blanksheet.min.css",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "author": "Peiwen Lu",
  "devDependencies": {
    "husky": "^9.1.7",
    "lightningcss-cli": "^1.31.1",
    "lint-staged": "^16.3.0",
    "playwright": "1.63.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.4.0",
    "stylelint-config-recess-order": "^7.6.1",
    "stylelint-order": "^7.0.1",
    "stylelint-prettier": "^5.0.3"
  },
  "lint-staged": {
    "*.{html,md,json,yaml,mjs}": [
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix --allow-empty-input"
    ]
  }
}
