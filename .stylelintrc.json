{
  "extends": ["stylelint-config-recess-order", "stylelint-prettier/recommended"],
  "rules": {
    "declaration-no-important": true,
    "property-disallowed-list": [
      "cursor",
      "scroll-behavior",
      "text-wrap",
      "text-wrap-style",
      "font-smooth",
      "-webkit-font-smoothing",
      "-moz-osx-font-smoothing"
    ],
    "color-no-hex": true
  }
}
